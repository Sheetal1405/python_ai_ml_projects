# INTEGRATED EXPENSE, ATTENDANCE, GRADING AND BILLING
CATEGORIES = ("Food", "Travel", "Utilities", "Stationery", "Other")
SUBJECTS = ("Python", "DBMS", "DSA", "AI", "ML")


def number(prompt, low=None, high=None, integer=False):
    while True:
        try:
            x = eval(input(prompt))

            if integer and (not isinstance(x, int) or isinstance(x, bool)):
                raise ValueError

            if not integer and not isinstance(x, (int, float)):
                raise ValueError

            if low is not None and x < low:
                raise ValueError

            if high is not None and x > high:
                raise ValueError

            return x
        except Exception:
            print("Invalid input. Try again.")


def student_name(prompt):
    while True:
        name = input(prompt).strip()

        if name and all(c.isalpha() or c.isspace() for c in name):
            return name

        print("Enter a valid name.")


def highest_lowest(values):
    highest = values[0]
    lowest = values[0]

    for value in values:
        if value > highest:
            highest = value
        if value < lowest:
            lowest = value

    return highest, lowest


def expense_menu(expenses):
    while True:
        print("\nExpense Management")
        print("1. Add Expense")
        print("2. View Expenses")
        print("3. Expense Summary")
        print("4. Back")

        choice = number("Choice: ", 1, 4, True)

        if choice == 1:
            description = input("Description: ").strip()
            amount = number("Amount: ", 0.01)

            print("1. Food  2. Travel  3. Utilities  4. Stationery  5. Other")
            category = CATEGORIES[number("Category: ", 1, 5, True) - 1]

            expenses.append({
                "description": description,
                "amount": amount,
                "category": category
            })

            print("Expense added.")

        elif choice in (2, 3):
            if not expenses:
                print("No expense records.")
                continue

            print("\nExpense Records")
            amounts = []
            total = 0

            for e in expenses:
                print(
                    f"{e['description']:<20}"
                    f"{e['category']:<15}"
                    f"₹{e['amount']:.2f}"
                )

                amounts.append(e["amount"])
                total += e["amount"]

            highest, lowest = highest_lowest(amounts)

            print(f"\nTotal Expense   : ₹{total:.2f}")
            print(f"Highest Expense : ₹{highest:.2f}")
            print(f"Lowest Expense  : ₹{lowest:.2f}")

            print("\nCategory-wise Total")
            for category in CATEGORIES:
                total_category = 0

                for e in expenses:
                    if e["category"] == category:
                        total_category += e["amount"]

                print(f"{category:<15}: ₹{total_category:.2f}")

        else:
            break


def attendance_menu(attendance):
    while True:
        print("\nAttendance Management")
        print("1. Mark Attendance")
        print("2. Attendance Summary")
        print("3. Back")

        choice = number("Choice: ", 1, 3, True)

        if choice == 1:
            roll = input("Registration/Roll No.: ").strip()
            name = student_name("Student Name: ")

            total_days = number(
                "Total Working Days: ",
                1,
                integer=True
            )

            present_days = number(
                "Present Days: ",
                0,
                total_days,
                True
            )

            percentage = present_days / total_days * 100

            if percentage >= 75:
                status = "Eligible"
            elif percentage >= 60:
                status = "Warning"
            else:
                status = "Shortage"

            attendance[roll] = {
                "name": name,
                "total": total_days,
                "present": present_days,
                "percentage": percentage,
                "status": status
            }

            print(f"Attendance : {percentage:.2f}%")
            print(f"Status     : {status}")

        elif choice == 2:
            if not attendance:
                print("No attendance records.")
                continue

            percentages = []
            eligible = 0
            warning = 0
            shortage = 0
            total_percentage = 0

            print("\nAttendance Report")

            for roll, s in attendance.items():
                print(
                    f"{roll:<15}"
                    f"{s['name']:<20}"
                    f"{s['percentage']:.2f}%  "
                    f"{s['status']}"
                )

                percentages.append(s["percentage"])
                total_percentage += s["percentage"]

                if s["status"] == "Eligible":
                    eligible += 1
                elif s["status"] == "Warning":
                    warning += 1
                else:
                    shortage += 1

            highest, lowest = highest_lowest(percentages)

            print(f"\nAverage Attendance : {total_percentage / len(percentages):.2f}%")
            print(f"Highest Attendance : {highest:.2f}%")
            print(f"Lowest Attendance  : {lowest:.2f}%")
            print(f"Eligible           : {eligible}")
            print(f"Warning            : {warning}")
            print(f"Shortage           : {shortage}")

        else:
            break


def grade(percentage):
    if percentage >= 90:
        return "A+"
    elif percentage >= 80:
        return "A"
    elif percentage >= 70:
        return "B"
    elif percentage >= 60:
        return "C"
    elif percentage >= 50:
        return "D"
    elif percentage >= 35:
        return "E"
    return "F"


def grading_menu(students):
    while True:
        print("\nGrading System")
        print("1. Add Student Marks")
        print("2. Student Report Card")
        print("3. Class Summary")
        print("4. Back")

        choice = number("Choice: ", 1, 4, True)

        if choice == 1:
            roll = input("Registration/Roll No.: ").strip()

            if roll in students:
                print("Roll No. already exists.")
                continue

            name = student_name("Student Name: ")

            try:
                marks = list(map(float, input(
                    "Enter Python DBMS DSA AI ML marks: "
                ).split()))

                if (
                    len(marks) != 5
                    or any(mark < 0 or mark > 100 for mark in marks)
                ):
                    raise ValueError

            except Exception:
                print("Enter exactly 5 marks between 0 and 100.")
                continue

            subject_marks = dict(zip(SUBJECTS, marks))

            total = 0
            failed = False

            for mark in marks:
                total += mark
                if mark < 35:
                    failed = True

            percentage = total / 5
            result = "FAIL" if failed else "PASS"
            final_grade = "F" if failed else grade(percentage)

            students[roll] = {
                "name": name,
                "marks": subject_marks,
                "total": total,
                "percentage": percentage,
                "grade": final_grade,
                "result": result
            }

            highest, lowest = highest_lowest(marks)

            print("\nStudent Added")
            print(f"Roll No.        : {roll}")
            print(f"Name            : {name}")
            print(f"Percentage      : {percentage:.2f}%")
            print(f"Grade           : {final_grade}")
            print(f"Result          : {result}")
            print(f"Highest Subject Mark : {highest:.2f}")
            print(f"Lowest Subject Mark  : {lowest:.2f}")

        elif choice == 2:
            if not students:
                print("No student records.")
                continue

            roll = input("Enter Roll No.: ").strip()

            if roll not in students:
                print("Student not found.")
                continue

            s = students[roll]

            print("\nStudent Report Card")
            print(f"Roll No. : {roll}")
            print(f"Name     : {s['name']}")

            for subject, mark in s["marks"].items():
                print(f"{subject:<10}: {mark:.2f}")

            marks = list(s["marks"].values())
            highest, lowest = highest_lowest(marks)

            print(f"\nTotal    : {s['total']:.2f}/500")
            print(f"Average  : {s['percentage']:.2f}%")
            print(f"Grade    : {s['grade']}")
            print(f"Result   : {s['result']}")
            print(f"Highest Mark : {highest:.2f}")
            print(f"Lowest Mark  : {lowest:.2f}")

        elif choice == 3:
            if not students:
                print("No student records.")
                continue

            percentages = []
            pass_count = 0
            fail_count = 0

            print("\nClass Summary")

            for roll, s in students.items():
                print(
                    f"{roll:<15}"
                    f"{s['name']:<20}"
                    f"{s['percentage']:.2f}%  "
                    f"{s['grade']}  {s['result']}"
                )

                percentages.append(s["percentage"])

                if s["result"] == "PASS":
                    pass_count += 1
                else:
                    fail_count += 1

            highest, lowest = highest_lowest(percentages)

            print(f"\nHighest Percentage : {highest:.2f}%")
            print(f"Lowest Percentage  : {lowest:.2f}%")
            print(f"Pass Students      : {pass_count}")
            print(f"Fail Students      : {fail_count}")

        else:
            break


def discount_rate(subtotal):
    if subtotal < 1000:
        return 0
    elif subtotal < 5000:
        return 5
    elif subtotal < 10000:
        return 10
    return 15


def billing_menu(bills):
    while True:
        print("\nBilling System")
        print("1. Create Bill")
        print("2. View Last Bill")
        print("3. Billing Summary")
        print("4. Back")

        choice = number("Choice: ", 1, 4, True)

        if choice == 1:
            customer = student_name("Customer Name: ")
            items = []

            while True:
                data = input(
                    "Item, Unit Price, Quantity (done to finish): "
                ).strip()

                if data.lower() == "done":
                    break

                try:
                    item, price, quantity = map(
                        str.strip,
                        data.split(",")
                    )

                    price = eval(price)
                    quantity = eval(quantity)

                    if (
                        price <= 0
                        or not isinstance(quantity, int)
                        or isinstance(quantity, bool)
                        or quantity <= 0
                    ):
                        raise ValueError

                    items.append({
                        "name": item,
                        "price": price,
                        "quantity": quantity,
                        "total": price * quantity
                    })

                except Exception:
                    print("Example: Notebook, 50, 2")

            if not items:
                print("No items added.")
                continue

            subtotal = 0
            item_totals = []

            for item in items:
                subtotal += item["total"]
                item_totals.append(item["total"])

            rate = discount_rate(subtotal)
            discount = subtotal * rate / 100
            taxable = subtotal - discount
            tax = taxable * 18 / 100
            final = taxable + tax

            highest, lowest = highest_lowest(item_totals)

            bill = {
                "number": f"B-{len(bills) + 1:04d}",
                "customer": customer,
                "items": items,
                "subtotal": subtotal,
                "discount": discount,
                "tax": tax,
                "final": final
            }

            bills.append(bill)

            print("\n========== INVOICE ==========")
            print(f"Bill No. : {bill['number']}")
            print(f"Customer : {customer}")

            for item in items:
                print(
                    f"{item['name']:<18}"
                    f"₹{item['price']:.2f}  "
                    f"{item['quantity']}  "
                    f"₹{item['total']:.2f}"
                )

            print(f"\nSubtotal       : ₹{subtotal:.2f}")
            print(f"Discount ({rate}%) : ₹{discount:.2f}")
            print(f"Tax (18%)      : ₹{tax:.2f}")
            print(f"Grand Total    : ₹{final:.2f}")
            print(f"Highest Item   : ₹{highest:.2f}")
            print(f"Lowest Item    : ₹{lowest:.2f}")

        elif choice == 2:
            if not bills:
                print("No billing records.")
                continue

            b = bills[-1]

            print("\nLast Bill")
            print(f"Bill No. : {b['number']}")
            print(f"Customer : {b['customer']}")

            for item in b["items"]:
                print(
                    f"{item['name']:<18}"
                    f"₹{item['price']:.2f}  "
                    f"{item['quantity']}  "
                    f"₹{item['total']:.2f}"
                )

            print(f"Subtotal    : ₹{b['subtotal']:.2f}")
            print(f"Discount    : ₹{b['discount']:.2f}")
            print(f"Tax         : ₹{b['tax']:.2f}")
            print(f"Grand Total : ₹{b['final']:.2f}")

        elif choice == 3:
            if not bills:
                print("No billing records.")
                continue

            totals = []
            sales = 0

            for b in bills:
                totals.append(b["final"])
                sales += b["final"]

            highest, lowest = highest_lowest(totals)

            print("\nBilling Summary")
            print(f"Total Bills    : {len(bills)}")
            print(f"Total Sales    : ₹{sales:.2f}")
            print(f"Average Bill   : ₹{sales / len(bills):.2f}")
            print(f"Highest Bill   : ₹{highest:.2f}")
            print(f"Lowest Bill    : ₹{lowest:.2f}")

        else:
            break


def reports(expenses, attendance, students, bills):
    print("\n========== REPORTS ==========")

    if expenses:
        values = [e["amount"] for e in expenses]
        highest, lowest = highest_lowest(values)
        print(f"Expense Highest : ₹{highest:.2f}")
        print(f"Expense Lowest  : ₹{lowest:.2f}")
    else:
        print("Expense: No records.")

    if attendance:
        values = [s["percentage"] for s in attendance.values()]
        highest, lowest = highest_lowest(values)
        print(f"Attendance Highest : {highest:.2f}%")
        print(f"Attendance Lowest  : {lowest:.2f}%")
    else:
        print("Attendance: No records.")

    if students:
        values = [s["percentage"] for s in students.values()]
        highest, lowest = highest_lowest(values)
        print(f"Grading Highest : {highest:.2f}%")
        print(f"Grading Lowest  : {lowest:.2f}%")
    else:
        print("Grading: No records.")

    if bills:
        values = [b["final"] for b in bills]
        highest, lowest = highest_lowest(values)
        print(f"Billing Highest : ₹{highest:.2f}")
        print(f"Billing Lowest  : ₹{lowest:.2f}")
    else:
        print("Billing: No records.")


